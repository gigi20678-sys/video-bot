# bot.py
import asyncio, os, re, uuid
from aiogram import Bot, Dispatcher, F
from aiogram.types import Message, FSInputFile
from aiogram.client.default import DefaultBotProperties
from aiogram.enums import ParseMode

TOKEN = os.getenv("BOT_TOKEN")
TMP = "/tmp/dl"
os.makedirs(TMP, exist_ok=True)

bot = Bot(token=TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
dp = Dispatcher()

URL_RE = re.compile(r"https?://\S+")

def run_ytdlp(url: str) -> str:
    """Синхронный вызов yt-dlp, возвращает путь к файлу."""
    from yt_dlp import YoutubeDL
    out = os.path.join(TMP, f"{uuid.uuid4().hex}.%(ext)s")
    opts = {
        "outtmpl": out,
        "format": "bv*+ba/b",
        "merge_output_format": "mp4",
        "quiet": True,
        "no_warnings": True,
        "noplaylist": True,
        "max_filesize": 512 * 1024 * 1024,   # лимит 512 МБ
        "http_headers": {"User-Agent": "Mozilla/5.0"},
        # для залогиненных/приватных видео:
        # "cookiesfrombrowser": ("chrome",),
    }
    with YoutubeDL(opts) as ydl:
        info = ydl.extract_info(url, download=True)
        path = ydl.prepare_filename(info)
    for cand in (path, os.path.splitext(path)[0] + ".mp4"):
        if os.path.exists(cand):
            return cand
    raise FileNotFoundError("файл не найден")

@dp.message(F.text & ~F.text.startswith("/"))
async def handler(message: Message):
    m = URL_RE.search(message.text or "")
    if not m:
        await message.answer("Пришли ссылку на видео 👇")
        return
    url = m.group(0)
    status = await message.answer("⏳ Качаю…")
    try:
        path = await asyncio.to_thread(run_ytdlp, url)
        size = os.path.getsize(path) / 1024 / 1024
        await message.answer_document(
            FSInputFile(path, filename=os.path.basename(path)),
            caption=f"✅ Готово ({size:.1f} МБ)"
        )
    except Exception as e:
        await message.answer(f"❌ Не вышло: <code>{e}</code>")
    finally:
        await status.delete()

@dp.message(F.text.startswith("/start"))
async def start(message: Message):
    await message.answer(
        "Скачиваю видео по ссылке. Поддерживаю YouTube, TikTok, Instagram*, X, ВК, "
        "Reddit, Twitch, Rutube и ещё ~1700 сайтов.\n"
        "*приватные/закрытые видео требуют cookie браузера\n\n"
        "Просто пришли ссылку."
    )

if __name__ == "__main__":
    asyncio.run(dp.start_polling
